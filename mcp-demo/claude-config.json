{
  "mcpServers": {
    "floe": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.floelabs.xyz/mcp",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer floe_YOUR_AGENT_KEY"
      }
    }
  }
}
