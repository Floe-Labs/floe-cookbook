# Copy this file to .env and fill in your keys. Never commit .env.
# The zero-key demo (python demo.py) needs NONE of these.

# Required to run the real crew (python crew.py). Your OpenAI API key.
OPENAI_API_KEY=sk-your-key-here

# Optional. Local spend ceiling in USD for the crew and the demo. Default: 1.00.
FLOE_BUDGET_USD=1.00

# Optional hosted upgrade. When set, crew.py reads your agent's server-side
# remaining budget from Floe and tightens the local cap to it. This READS the
# budget to inform the local ceiling; un-bypassable cross-vendor enforcement is
# the hosted Floe product. Get a key at https://dev-dashboard.floelabs.xyz
FLOE_API_KEY=floe_your_key_here
