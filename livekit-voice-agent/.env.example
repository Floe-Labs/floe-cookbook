# ── Floe (LLM + TTS meter here) ──────────────────────────────────────────────
# Agent key (floe_…) from https://dev-dashboard.floelabs.xyz. Set a spend cap on
# this agent so the run is bounded (dashboard, or PUT /v1/agents/spend-limit).
FLOE_API_KEY=
FLOE_BASE_URL=https://credit-api.floelabs.xyz/v1
FLOE_LLM_MODEL=openai/gpt-4o-mini
FLOE_TTS_MODEL=openai/tts-1
FLOE_TTS_VOICE=alloy

# floe-guard local per-call budget ceiling, in USD (a dollar cap you own
# in-process, separate from the Floe balance). The guard hard-stops a turn
# before its LLM call once this call's spend would cross the cap.
FLOE_LOCAL_BUDGET_USD=0.50

# ── Deepgram (streaming STT — the BYO path this example runs) ────────────────
# Floe's streaming STT WebSocket is live (see README), but this example keeps
# the stt= line in agent.py on BYO Deepgram, so this key is still required to
# run it as-is. To drop it, point a websocket STT adapter at Floe's
# /v1/audio/transcriptions/stream instead.
DEEPGRAM_API_KEY=

# ── LiveKit (Cloud or self-hosted) ───────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
