# ── Floe (LLM + TTS meter here) ──────────────────────────────────────────────
# Agent key (floe_…) from https://dev-dashboard.floelabs.xyz. Set a spend cap on
# this agent so the run is bounded (dashboard, or PUT /v1/agents/spend-limit).
FLOE_API_KEY=
FLOE_BASE_URL=https://credit-api.floelabs.xyz/v1
FLOE_LLM_MODEL=openai/gpt-4o-mini
FLOE_TTS_MODEL=openai/tts-1
FLOE_TTS_VOICE=alloy

# ── Deepgram (streaming STT — BYO for now) ───────────────────────────────────
# The one leg not on Floe yet. LiveKit needs a live streaming-STT feed; Floe's
# STT is batch today (native streaming STT is on the roadmap). When it ships,
# delete this and swap the stt= line in agent.py for Floe.
DEEPGRAM_API_KEY=

# ── LiveKit (Cloud or self-hosted) ───────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
