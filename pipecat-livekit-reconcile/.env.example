# Floe Reconcile Mode — self-report end-of-call cost from a self-hosted
# Pipecat or LiveKit agent.

# Live Floe API. Leave as-is unless you're pointing at a local/staging instance.
FLOE_CREDIT_API=https://credit-api.floelabs.xyz

# Register a Reconcile connection to get the token + secret below. Either:
#   - Dashboard: https://dev-dashboard.floelabs.xyz → your agent → Reconcile / orchestrators
#   - API:  POST /v1/developer/orchestrators  (developer key floe_live_…)
#           body: { "agentId": <id>, "provider": "pipecat"|"livekit", "label": "…" }
# The response returns a webhookUrl containing the TOKEN, and the per-connection
# SECRET (shown ONCE). The token identifies the connection; the secret signs the body.

# Capability token from the returned webhookUrl (.../call-end/<TOKEN>).
FLOE_ORCHESTRATOR_TOKEN=

# Per-connection secret Floe returned at registration (shown once). Used to
# compute X-Floe-Signature = hex HMAC-SHA256(secret, raw body).
FLOE_ORCHESTRATOR_SECRET=

# Which self-hosted framework this connection is for. Or pass as the first arg:
# `python reconcile.py livekit`.
# FLOE_ORCHESTRATOR_PROVIDER=pipecat
