# ── Floe keys ─────────────────────────────────────────────────────────────
# Developer key (floe_live_…) — for provisioning: buy a number, set voice config.
# Get it at https://dev-dashboard.floelabs.xyz/keys
FLOE_LIVE_KEY=

# Agent key (floe_…) — for placing calls + the in-call LLM/tool spend. One agent.
# Dashboard → your agent → copy the floe_… key (shown once).
FLOE_API_KEY=

# The numeric agent id that owns the phone number (from the dashboard URL / list).
FLOE_AGENT_ID=

# ── Server ────────────────────────────────────────────────────────────────
# Public HTTPS URL Floe Phone posts each caller utterance to (webhook mode).
# Use ngrok for local dev: ngrok http 3000  → paste the https URL here.
# setup.ts appends /floe/voice/<WEBHOOK_SECRET>; must be https.
SERVER_URL=https://your-ngrok-url.ngrok-free.app
PORT=3000

# Shared secret that authenticates Floe Phone's webhook to THIS server. Floe Phone
# sends no auth header, so setup.ts bakes this into the webhook URL path
# (/floe/voice/<secret>) and the server rejects any request that doesn't match —
# without it, the public webhook could be hit to burn budget + pollute transcripts.
# Use a long random value:  openssl rand -hex 24
WEBHOOK_SECRET=

# ── Campaign budgets ──────────────────────────────────────────────────────
# Session (campaign) spend cap in USDC base units (6 decimals): 2000000 = $2.00.
# Caps the WHOLE campaign's LLM + tool spend across calls (set on the agent key).
FLOE_SESSION_LIMIT_RAW=2000000

# ── Optional ──────────────────────────────────────────────────────────────
# Keyless model for the sales brain (any Floe Inference model id). Fast + cheap
# is best for voice. Default: openai/gpt-4o-mini.
FLOE_MODEL=openai/gpt-4o-mini

# Area code to request when buying a number (optional; omit for any US number).
AREA_CODE=415

# Exa API base — the one real paid tool the agent uses to research a prospect,
# routed through Floe's x402 proxy so it meters on the same key.
EXA_URL=https://api.exa.ai/search

# Floe API base (rarely changed).
FLOE_CREDIT_API=https://credit-api.floelabs.xyz
