# ── Floe (LLM meters on the gateway; the reconcile push uses this same key) ──
# Agent key (floe_…) from https://dev-dashboard.floelabs.xyz. Set a spend cap on
# this agent so the run is bounded (dashboard, or PUT /v1/agents/spend-limit).
FLOE_API_KEY=
FLOE_BASE_URL=https://credit-api.floelabs.xyz/v1
FLOE_LLM_MODEL=openai/gpt-4o-mini

# floe-guard local per-call ceiling, in USD — the ONE budget every leg shares
# (LLM, STT, TTS, avatar, tools). The guard hard-stops a turn before its LLM
# call once this call's spend would cross the cap.
FLOE_LOCAL_BUDGET_USD=0.50

# What one call of the demo paid tool (lookup_company) costs you — the price you
# pay the vendor, recorded onto the same budget and reconciled to the ledger.
FLOE_TOOL_PRICE_USD=0.02

# Your avatar vendor's per-minute rate (Tavus / HeyGen / Simli / Beyond
# Presence). Avatars bill per minute of generated video and LiveKit emits no
# metric for them, so the leg is recorded from call duration × this rate at
# call end. Leave at 0 to record no avatar leg.
FLOE_AVATAR_USD_PER_MINUTE=0

# Set to 1 to PRINT the legs that would reconcile instead of POSTing them —
# a dry run that touches no network (useful for a first try).
FLOE_RECONCILE_DRY_RUN=

# ── Deepgram (BYO streaming STT — reconciled, not carried by Floe) ───────────
DEEPGRAM_API_KEY=

# ── ElevenLabs (BYO TTS — reconciled, not carried by Floe) ──────────────────
ELEVENLABS_API_KEY=

# ── LiveKit (Cloud or self-hosted) ───────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
