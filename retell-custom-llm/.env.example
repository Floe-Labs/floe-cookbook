# Retell dashboard → API keys
RETELL_API_KEY=

# Your Floe AGENT key (floe_<hex>)
FLOE_API_KEY=

# Session spend cap in USDC base units (6 decimals). 100000 = $0.10.
FLOE_SPEND_LIMIT_RAW=100000

# Catalog model slug (GET /v1/models). Voice wants fast + cheap.
FLOE_MODEL=openai/gpt-4o-mini

# floe-guard LOCAL per-call budget ceiling, in USD (a dollar cap you own
# in-process, separate from FLOE_SPEND_LIMIT_RAW which Floe enforces server-side).
# Reservation-based: the guard reserves a turn's estimated cost before its LLM
# call and settles real usage after. It blocks a NEW turn when the reservation
# would cross the cap; it does not interrupt a turn already in flight.
FLOE_LOCAL_BUDGET_USD=0.10

# Public wss base of THIS server (e.g. from `ngrok http 3112` → use wss://…)
SERVER_WSS_URL=

# Path secret — Retell's custom-LLM socket carries no auth header, so the
# unguessable path segment is the auth. ≥16 chars.
LLM_PATH_SECRET=

FLOE_CREDIT_API_URL=https://credit-api.floelabs.xyz
PORT=3112
