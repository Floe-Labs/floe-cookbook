# Vapi dashboard → API keys (server key)
VAPI_API_KEY=

# Your Floe AGENT key (floe_<hex>, NOT the floe_live_ developer key)
# dev-dashboard.floelabs.xyz → your agent → API keys
FLOE_API_KEY=

# Session spend cap in USDC base units (6 decimals). 100000 = $0.10.
FLOE_SPEND_LIMIT_RAW=100000

# Catalog model slug the assistant's brain runs on (see GET /v1/models)
FLOE_MODEL=openai/gpt-4o-mini

# Floe API base — override only for staging
FLOE_CREDIT_API_URL=https://credit-api.floelabs.xyz

# ── Shim variant only (npm run shim) ─────────────────────────────────────
# Set BOTH and re-run `npm run setup` to provision the assistant against the
# shim: model.url then becomes $SERVER_URL/llm/$SHIM_PATH_SECRET instead of
# Floe directly. SERVER_URL = the shim's public URL (e.g. ngrok);
# SHIM_PATH_SECRET ≥16 chars. Leave BOTH unset for the direct integration.
SERVER_URL=
SHIM_PATH_SECRET=
