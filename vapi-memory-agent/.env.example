# Vapi private key — https://dashboard.vapi.ai
# Server-side only (setup.ts + call.ts). Never put this in the browser.
VAPI_API_KEY=

# Assistant id — printed by setup.ts after it creates the assistant.
VAPI_ASSISTANT_ID=

# Vapi phone number id to call FROM (blank → call.ts uses your first number).
VAPI_PHONE_NUMBER_ID=

# The caller's cell to call, E.164 (e.g. +14155551234).
TARGET_PHONE_NUMBER=

# Floe — get your key at https://dev-dashboard.floelabs.xyz
# ONE key pays the model (Venice) AND the memory (HydraDB) — unified billing.
FLOE_API_KEY=

# Venice text model (marketplace: dev-dashboard.floelabs.xyz/vendors/venice-compute).
# mistral-small-3-2-24b-instruct is a fast, tool-calling model good for voice.
VENICE_MODEL=mistral-small-3-2-24b-instruct

# Spend limit in USDC base units (6 dp): 250000 = $0.25. One ceiling over model
# + memory. setup.ts sets it on your Floe key.
FLOE_SPEND_LIMIT_RAW=250000

# Webhook secret — authenticates Vapi's tool-call (remember/recall) webhooks.
VAPI_SERVER_SECRET=

# Separate secret for the LLM shim URL path (/llm/<secret>/chat/completions).
# Kept distinct from VAPI_SERVER_SECRET so the Vapi-held URL token, if leaked,
# authorizes model inference only — not memory writes. Rotate independently.
LLM_SHIM_SECRET=

# Your server's public URL (use ngrok for local dev).
SERVER_URL=https://your-ngrok-url.ngrok-free.app

# Server port
PORT=3000
